# Local GitHub OAuth application only. Never commit actual values.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=replace-with-local-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=replace-with-local-oauth-secret
# Edge runtime supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# The service-role key is backend-only and must never have a VITE_ prefix.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
