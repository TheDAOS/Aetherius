{"nodes": [{"id": "agents_project_identity", "label": "Aetherius Project Identity", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L1-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_core_architecture", "label": "Core Architecture (PWA \u2192 Supabase \u2192 Edge Functions \u2192 GitHub \u2192 Repository)", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L21-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_github_source_of_truth", "label": "GitHub Is the Source of Truth (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L59-L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User vault contents must remain canonical in the user's private GitHub repository to preserve portability, user ownership, and Git-based version history. Supabase and local caches are derived state."}, {"id": "agents_markdown_canonical_format", "label": "Markdown Is the Canonical Note Format (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L69-L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes must remain ordinary Markdown files so users can access their data outside the application. Frontmatter is acceptable but Markdown remains canonical."}, {"id": "agents_supabase_not_canonical", "label": "Supabase Is Not Canonical Note Storage (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L79-L93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supabase handles authentication, session management, vault metadata, and Edge Functions but must never store canonical Markdown note contents. Any change requires an ADR and project-owner approval."}, {"id": "agents_clients_no_privileged_github", "label": "Clients Must Not Perform Privileged GitHub Operations (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L96-L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PWA and Swift apps must route GitHub operations through Supabase API/Edge Function to prevent credential exposure."}, {"id": "agents_pwa_swift_shared_api", "label": "PWA and Swift Must Use the Same API (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L116-L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PWA and future Swift/iOS application must consume the same backend API contract (OpenAPI). No separate backend for iOS."}, {"id": "agents_openapi_sync", "label": "OpenAPI Must Stay in Sync (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L126-L139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any API change must update openapi/openapi.yaml. API behavior should be independently testable."}, {"id": "agents_db_migrations", "label": "Database Changes Require Migrations (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L142-L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema changes must be represented by migrations; no manual production schema changes without a migration."}, {"id": "agents_mvp_simplicity", "label": "Keep the MVP Simple (Rule)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L176-L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not prematurely implement GraphRAG, vector DBs, embeddings, semantic search, knowledge graphs, conflict-resolution engines, or AI features. First objective is a reliable Git-backed Markdown vault."}, {"id": "agents_ai_dev_workflow", "label": "AI Development Workflow", "file_type": "do